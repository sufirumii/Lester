# ── Lester configuration ──────────────────────────────────────────────────────
# Every setting has a safe default. No secrets live in this file.
# Copy to .env and adjust. The Console (Settings tab) manages most of this
# at runtime; these values are the boot-time baseline.

# Database (SQLite). Leave this unset for native installs: Lester then uses
# <project>/db/lester.db (or <LESTER_DATA_DIR>/lester.db). A relative path here
# is resolved against the project folder. Keep connection_limit=1. Docker sets
# this itself in docker-compose.yml.
# DATABASE_URL="file:./db/lester.db?connection_limit=1"

# Where Lester stores the database, backups and key material.
# Leave unset to use <project>/db. In Docker this is /app/data.
# LESTER_DATA_DIR="/var/lib/lester"

# Backups default to DATA/backups. Point this at another volume/disk so a
# dead disk cannot take the only copies with it (D2):
# LESTER_BACKUP_DIR="/mnt/backup/lester"

# ── Server binding (B4) ──────────────────────────────────────────────────────
# Loopback-only by default. Exposing Lester to the LAN is an explicit operator
# decision: set LESTER_BIND=0.0.0.0 and restart. Put TLS in front first.
LESTER_BIND="127.0.0.1"
# One port variable, used by `bun run start:prod` and Docker.
LESTER_PORT="8090"

# Set true only when a trusted reverse proxy (Caddy/nginx) fronts Lester and
# sets X-Forwarded-* headers. Required for the Secure cookie flag behind TLS.
LESTER_TRUST_PROXY="false"

# ── Local inference engine (boot-time default; editable in Settings → Engine)
# auto          = probe the common ports for Ollama/LM Studio/llama.cpp/vLLM
# ollama        = http://127.0.0.1:11434/v1 (also probes the Docker sidecar
#                 and host.docker.internal for compose deployments)
# lmstudio      = http://127.0.0.1:1234/v1
# llamacpp      = http://127.0.0.1:8080/v1
# vllm          = http://127.0.0.1:8000/v1
# openai-compat = any endpoint; set LESTER_ENGINE_URL too
# none          = start without an engine (configure later in the Console)
LESTER_ENGINE="auto"
LESTER_ENGINE_URL=""
# Extra detection URLs for non-standard setups (comma-separated):
# LESTER_ENGINE_CANDIDATES="http://192.168.1.50:11434/v1"

# ── Key material (D4) ────────────────────────────────────────────────────────
# By default the master key lives in DATA/keys/server.key (0600). Point it at
# another volume/removable device if you want the key off the data disk:
# LESTER_MASTER_KEY_FILE="/mnt/keys/lester-server.key"
# Proof signing key override (rotation: bun scripts/cli.ts rotate-proof-key):
# LESTER_PROOF_SIGNING_KEY_FILE="/mnt/keys/lester-proof-signing.pem"

# ── Licensing (offline, vendor-key pinned in source) ────────────────────────
# License keys verify against the vendor public key pinned in
# src/lib/license.ts (VENDOR_LICENSE_PUB_HEX). Contributors testing locally: run
# `bun run license:devkey` (writes LESTER_LICENSE_PUB into .env).
# LESTER_LICENSE_PUB=""
# Issuing side only (never on a customer node):
# LESTER_LICENSE_PRIV=""

# ── Server behaviour ────────────────────────────────────────────────────────
# Prompt-content audit logging. false = the Proof ledger stores metadata only.
LESTER_CONTENT_LOGGING="false"

# Optional encryption at rest for message content (AES-256-GCM).
LESTER_ENCRYPT_AT_REST="false"

# Session lifetime in hours (Console sessions).
LESTER_SESSION_TTL_HOURS="72"

# Backup schedule: daily at this hour (0–23, server time), retain this many.
LESTER_BACKUP_HOUR="3"
LESTER_BACKUP_KEEP="14"

# Allow engine/provider URLs that resolve into link-local / cloud-metadata
# space (169.254.0.0/16). Almost always a mistake — leave unset.
# LESTER_ALLOW_METADATA_ENDPOINTS="false"

# Telemetry: none exists in Lester. This variable is intentionally unused and
# documented to make the absence explicit and greppable.
# LESTER_TELEMETRY="does-not-exist"
